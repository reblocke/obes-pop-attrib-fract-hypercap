# macOS Finder metadata
.DS_Store

/data_derived/
full_db.rds
.Rhistory

# Local restricted/raw data
/data/raw/*
!/data/raw/.gitkeep

# Private conference drafting material; retain locally outside public Git.
/reports/ATS Abstract 2027/

# Quarto render outputs generated for local review
/reports/*.html
/reports/*.pdf
/reports/*.log
/reports/*.tex
/reports/*.aux
/reports/*.out
/reports/*.toc
/reports/*.knit.md
/reports/*.rmarkdown
/reports/*_files/
reports/.RData

# Restricted Stata inputs, local aggregate evidence, and execution receipts
full_db.dta
/artifacts/stata/
/artifacts/evidence/
__pycache__/

# Local analysis runs and input manifests; reviewed aggregate outputs may be
# versioned separately. This rule is not a prohibition on sharing analysis results.
/artifacts/triangulation/
/config/triangulation_input.local.json
/config/common_index_preparation.local.json
/config/common_index_mapping.local.json

# Archived-source replays and historical generated reports
/artifacts/historical-r/
/archive/**/*.html
/archive/**/*.pdf
/archive/**/*.log
/archive/**/*.tex
/archive/**/*.knit.md
/archive/**/*_files/
**/.RData
